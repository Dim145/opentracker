# syntax=docker/dockerfile:1.7
# Trackarr web — static SPA build, distroless nginx runtime.
#
# This image is the no-SSR alternative to apps/web/Dockerfile. Memory
# footprint is < 30 MB at idle, vs. ~120 MB for the Nuxt SSR runtime,
# at the cost of pre-rendering being skipped — every page hydrates
# entirely client-side. Use this when:
#   - you don't need SEO out of the SSR pipeline
#   - the API is on the same origin (Caddy handles /api/* + /announce)
#   - you want a single image that's portable across domains
#
# Runtime config: tracker URLs are fetched from /api/runtime-config
# on boot by apps/web/plugins/runtime-config.client.ts, so the same
# image works against any deployment without rebuilding.
#
# Base for the runtime is Chainguard's hardened, fully distroless
# nginx — no shell, no package manager, runs as non-root, signed.

# -----------------------------------------------------------------------------
# Install workspace dependencies (cached on package.json + lockfile)
# -----------------------------------------------------------------------------
FROM node:24-alpine AS deps
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --filter "@trackarr/web..." --frozen-lockfile

# -----------------------------------------------------------------------------
# Build the SPA. NUXT_STATIC_BUILD=true is read by nuxt.config.ts to
# turn `ssr: false`, and `nuxi generate` writes the prerendered static
# tree to apps/web/.output/public/.
# -----------------------------------------------------------------------------
FROM node:24-alpine AS builder
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared
# `packages/shared/tsconfig.json` extends this file. The bundler resolves the
# tsconfig chain when it transforms the shared sources, which it started doing
# when the release parser moved into the package — and dies without the base.
# The SSR and API images already copy it; this one was missed because it is not
# part of the local compose stack.
COPY tsconfig.base.json ./
ENV NUXT_STATIC_BUILD=true \
    NODE_ENV=production
# `--mount=type=cache` on the font cache, and it is not a speed optimisation.
# `@nuxt/fonts` fetches each family's metadata from Google at build time, and a
# machine that rebuilds this image repeatedly gets tarpitted: measured here as
# `ETIMEDOUT` on every request while an ordinary container reached the same URL
# in 0.2 s. The cache means a rebuild refetches nothing, which turns the failure
# mode from "the build breaks" into "the first build of the day is the only one
# that needs Google".
#
# It does not help a cold CI runner. If a release pipeline cannot tolerate a
# retry, switch the families to `provider: 'local'` — see apps/web/nuxt.config.ts.
RUN --mount=type=cache,target=/app/node_modules/.cache/nuxt,sharing=locked \
    pnpm --filter @trackarr/web exec nuxi generate

# -----------------------------------------------------------------------------
# Runtime — Chainguard distroless nginx (truly distroless, no shell).
#   - Listens on 8080 by default (non-priv user)
#   - Reads its config from /etc/nginx/nginx.conf
#   - Serves /usr/share/nginx/html
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/nginx:latest AS runner

# nginx config (SPA fallback, gzip, asset caching, /healthz)
COPY apps/web/docker/static/nginx.conf /etc/nginx/nginx.conf

# Static SPA bundle. nuxi generate writes everything into .output/public,
# including the rendered index.html and the hashed _nuxt/ chunks.
COPY --from=builder --chown=nginx:nginx /app/apps/web/.output/public/ /usr/share/nginx/html/

# Restate the image's own default (uid 65532, user `nginx`) instead of
# leaving it implicit. Runtime behaviour is unchanged — it makes the
# non-root guarantee readable in the Dockerfile and checkable by a
# scanner that only sees the build recipe.
USER 65532

EXPOSE 3000
STOPSIGNAL SIGQUIT

# Pas de HEALTHCHECK ici, et c'est délibéré.
#
# Il y en avait un : `CMD ["/usr/sbin/nginx", "-t"]`. Or `-t` valide le FICHIER
# DE CONFIGURATION — un worker bloqué, un listener fermé, un disque plein
# passent tous au vert. Un feu vert qui ne mesure rien est pire que pas de feu
# du tout : il transforme une panne en « sain » sur le tableau de bord.
#
# Le commentaire affirmait par ailleurs « we override to hit /healthz » ; la
# commande ne faisait pas cela. Les deux configurations exposent bien un vrai
# `/healthz`, mais l'image Chainguard n'a ni shell, ni wget, ni curl (vérifié :
# `/bin/sh` n'existe pas), donc rien ne peut l'interroger depuis l'intérieur du
# conteneur.
#
# La sonde revient donc à l'orchestrateur, qui sait le faire depuis l'extérieur :
# `readinessProbe: httpGet: { path: /healthz }` côté Kubernetes, ou un
# `healthcheck:` dans le compose si l'on veut la garder ici.

# The Chainguard image's default ENTRYPOINT runs `nginx -g 'daemon off;'`
# from the right user — no overrides needed.
