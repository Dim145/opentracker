{
  "name": "trackarr",
  "version": "0.28.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:load": "tsx tests/load/load-test.ts",
    "db:push": "pnpm --filter @trackarr/db run db:push",
    "db:generate": "pnpm --filter @trackarr/db run db:generate",
    "db:studio": "pnpm --filter @trackarr/db run db:studio",
    "postinstall": "find -L node_modules \\( -name .output -o -name .nuxt -o -name .git \\) -prune -o -type d -name simple-peer -exec sh -c 'echo \"export default null;\" > \"$1/lite.js\"' _ {} \\;"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "node-datachannel": "npm:empty-npm-package@1.0.0",
      "webrtc-polyfill": "npm:empty-npm-package@1.0.0",
      "@thaunknown/simple-peer": "npm:empty-npm-package@1.0.0",
      "esbuild": "^0.28.1",
      "shell-quote": "^1.9.0",
      "dompurify": "^3.4.13",
      "launch-editor": "^2.14.1",
      "devalue": "^5.8.1",
      "ws@8": "^8.20.1",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.16",
      "postcss@8": "^8.5.23",
      "tar@7": "^7.5.21",
      "undici@7": "^7.29.0",
      "svgo@4": "^4.0.2",
      "@babel/core@7": "^7.29.6",
      "@types/node": "^24.13.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  }
}
