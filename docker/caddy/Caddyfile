# Trackarr production Caddyfile
# Routes:
#   - your-domain.com/api/*    → api container
#   - your-domain.com/announce → tracker container (announce on main domain)
#   - your-domain.com/*        → web container (Nuxt SSR)
#   - tracker.your-domain.com/announce → tracker container (announce on subdomain)

{
	email {$ACME_EMAIL:admin@example.com}
}

# Strip client-suppliable IP-trust headers before proxying upstream.
# We overwrite X-Real-IP / X-Forwarded-For with the real peer in every
# block below, but CF-Connecting-IP / True-Client-IP are NOT set here and
# would otherwise pass through verbatim. The api (getClientIP) and tracker
# (clientIP) read CF-Connecting-IP first, so a client sending a forged
# value could spoof its effective IP — bypassing IP bans + rate limits and
# framing a victim's IP into the DDoS blacklist (finding H2). Imported into
# every reverse_proxy block. Re-add these headers ONLY if the stack is
# genuinely fronted by Cloudflare AND ingress is restricted to Cloudflare's
# published IP ranges (and set TRUST_CF_CONNECTING_IP=true on api+tracker).
(strip_spoofable_ip_headers) {
	header_up -CF-Connecting-IP
	header_up -True-Client-IP
}

# -----------------------------------------------------------------------------
# Main app: web frontend + api + tracker on the same hostname
# -----------------------------------------------------------------------------
{$DOMAIN:localhost} {
	header {
		# Clickjacking: SAMEORIGIN keeps the auth/upload flows
		# embeddable from the same domain (useful for OAuth-style
		# popups in future) but blocks any external iframe wrapping
		# admin pages.
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		# X-XSS-Protection is removed: deprecated by browsers and
		# can introduce its own bugs. CSP below replaces it.
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
		# Content-Security-Policy is deliberately NOT set at site level.
		# `header` REPLACES the upstream value, and the Nuxt container
		# now emits a per-response policy carrying a nonce so that
		# `script-src` can drop `'unsafe-inline'` (see
		# apps/web/server/plugins/csp.ts). Setting a static policy here
		# would silently overwrite the nonce with the weaker one.
		# The two handles Caddy answers on behalf of the API get their
		# own policy below; the api container also sends one.
		-Server
	}

	encode gzip zstd

	# La taille de corps, bornée à la bordure.
	#
	# Caddy n'a AUCUNE limite par défaut : `request_body { max_size }` est
	# facultatif. Or `POST /api/torrents` fait passer le corps entier par
	# `readMultipartFormData`, qui le met en mémoire AVANT que les gardes 413 de
	# la route (10 Mio pour le .torrent, 256 Kio pour le NFO) puissent se
	# prononcer — le commentaire de la route le dit lui-même. Un membre
	# authentifié envoyant un POST de 600 Mo faisait donc dépasser le tas
	# (plafonné à 512 Mo) dans un conteneur plafonné à 768 Mo : OOM, redémarrage
	# par `restart: always`, et l'opération se répète pour le prix de la bande
	# passante montante.
	#
	# 32 Mo aligne ce déploiement sur le chart Helm, qui borne déjà à `32m` via
	# `proxy-body-size` — c'était le chemin Compose, celui que les opérateurs
	# tiers installent, qui n'avait rien. `request_body` est dans l'ordre par
	# défaut des directives (avant `reverse_proxy`), donc la poser au niveau du
	# site couvre tous les `handle`. Les annonces et le flux SSE sont en GET :
	# aucun effet sur eux.
	request_body {
		max_size 32MB
	}

	# Tracker announce on the main domain (what BitTorrent clients hit when
	# the .torrent file's `announce` is your-domain.com/announce).
	handle /announce* {
		reverse_proxy tracker:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			import strip_spoofable_ip_headers
		}
	}

	# All API routes (including /api/uploads/*, /api/health, /api/torrents/...).
	handle /api/* {
		# JSON and images only — nothing here should ever be treated as a
		# document, let alone run a script. The api container sends its own
		# policy too; this one is the edge's floor.
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		reverse_proxy api:4000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			import strip_spoofable_ip_headers
		}
	}

	# Public uploads served by the API.
	handle /uploads/* {
		reverse_proxy api:4000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			import strip_spoofable_ip_headers
		}
	}

	# Messaging relay. Separate from /api/* because it is a separate
	# process with a different lifetime: these connections are held open
	# for minutes, and they must not share the API's proxy settings.
	# Only /events. The relay serves /metrics and /healthz on the same
	# port, unauthenticated, because they are meant to be internal — and a
	# /messaging/* route would have published both.
	handle /messaging/events* {
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		reverse_proxy relay:4100 {
			# Without this Caddy buffers the response and every event
			# arrives when the stream closes, which for SSE is never.
			flush_interval -1
			# A stream that outlives the default 30s read timeout is the
			# normal case here, not a stuck upstream.
			transport http {
				read_timeout 0
			}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			import strip_spoofable_ip_headers
		}
	}

	# Everything else goes to the Nuxt web container (SSR pages + assets).
	handle {
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			import strip_spoofable_ip_headers
		}
	}

	# Drop every credential query param from access logs before they hit
	# disk. The tracker requires `passkey` in the URL by BitTorrent protocol,
	# and a feed reader puts `apikey` there because Torznab has no other way
	# to carry one — so we can't strip them from the request itself, but we
	# can prevent them from being persisted in the log file (which is
	# otherwise a textbook log-leak vector for credential exfiltration).
	#
	# `apikey` and `rsskey` joined `passkey` when the read surfaces got keys
	# of their own: before that, `apikey` WAS the passkey and this scrub
	# covered it by accident rather than on purpose.
	#
	# `token` joined them last, and it was the one real hole: the messaging
	# relay is proxied from this same site (`handle /events*` above), and
	# `EventSource` cannot set an Authorization header — so the relay token
	# HAS to ride in the query string, as `internal/sse/handler.go` says in
	# as many words. Every SSE connection was therefore writing a valid
	# bearer token into this file, kept for 720h. The token only lives 300s
	# (`MESSAGING_TOKEN_TTL_SECONDS`), so the window was small, but a
	# 30-day record of credentials is exactly what this block exists to
	# prevent.
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				# `request>uri`, PAS `uri`.
				#
				# La clé d'un champ dans ce bloc est son chemin aplati dans
				# l'entrée JSON, et l'URI y vit sous `request`. Avec `uri`, le
				# filtre ne correspond à AUCUN champ : Caddy ne s'en plaint pas,
				# ne journalise rien d'anormal, et écrit l'URI telle quelle.
				# Mesuré sur la pile compilée le 2026-09-02 : une requête
				# `/events?token=CANARY…` et une `?apikey=CANARY…` sont
				# ressorties entières du fichier. Le nettoyage du `passkey`
				# décrit au-dessus n'avait donc jamais eu lieu.
				request>uri query {
					delete passkey
					delete apikey
					delete rsskey
					delete token
				}
			}
		}
	}
}

# -----------------------------------------------------------------------------
# Tracker subdomain: dedicated host so .torrent announce URLs can use a clean
# `tracker.your-domain.com/announce` URL.
# -----------------------------------------------------------------------------
{$TRACKER_DOMAIN:tracker.localhost} {
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Deux chemins, pas tout le tracker.
	#
	# Ce bloc relayait `tracker:8080` sans filtre, donc `/health` était public :
	# il rend l'état de Postgres et de Redis à quiconque. L'API garde
	# délibérément ce détail pour elle (`api/tracker-health.get.ts` ne surface
	# qu'un booléen « joignable », et son commentaire dit que la ventilation par
	# composant est un diagnostic d'administrateur) — le sous-domaine du tracker
	# la donnait par la porte de derrière.
	handle /announce* {
		reverse_proxy tracker:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			import strip_spoofable_ip_headers
		}
	}

	handle /scrape* {
		reverse_proxy tracker:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			import strip_spoofable_ip_headers
		}
	}

	# Tout le reste — `/health` en particulier — n'a pas à sortir. Le
	# healthcheck du conteneur interroge le tracker directement sur le réseau
	# interne, il n'est pas concerné.
	handle {
		respond 404
	}

	# Same passkey scrub as on the main domain — every request to this
	# subdomain is an announce, so every line otherwise carries a
	# passkey in the URL.
	log {
		output file /var/log/caddy/tracker.log {
			roll_size 100mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				# `request>uri` et non `uri` — voir le bloc du domaine principal.
				request>uri query {
					delete passkey
					delete apikey
					delete rsskey
					delete token
				}
			}
		}
	}
}
